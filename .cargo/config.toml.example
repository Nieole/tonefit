# AVIF 解码经 dav1d，dav1d-sys 通过 pkg-config 定位它。
#
# 两种提供方式，二选一：
#   1. 复制本文件为 .cargo/config.toml，把下面的路径改成本机的
#   2. 在 shell 里导出同名环境变量，不创建 .cargo/config.toml
#
# dav1d 可由 vcpkg 提供：vcpkg install dav1d:x64-windows-static-md
# 路径指向该安装目录下的 lib/pkgconfig。
# 可用性矩阵见 docs/measurements.md 的《AVIF 解码的可用路径》。

[env]
PKG_CONFIG_PATH = "<vcpkg 安装目录>/installed/x64-windows-static-md/lib/pkgconfig"
